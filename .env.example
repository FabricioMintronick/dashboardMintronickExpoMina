# Completar localmente. Nunca publicar credenciales.
MONGO_URI=
MONGO_DB=MTKDATA
MONGO_COLLECTION=iotdatas
# Colección independiente para encoder y sensor lineal.
MONGO_SENSORS_COLLECTION=sensors
# Token secreto de 32 caracteres o más usado por el receptor MQTT.
SENSOR_INGEST_TOKEN=
PORT=4001
# Referencia técnica provisional, NO umbral OEM ni SLA validado.
STALE_AFTER_SECONDS=120
ENABLE_PING=false
# Traslación pública: lat'=lat+offset y lon'=lon+offset. Reinicia el servidor al cambiarla.
GPS_PRIVACY_ENABLED=true
GPS_LAT_OFFSET=0.75
GPS_LON_OFFSET=0.75
# Acceso web. AUTH_SECRET debe ser aleatorio y tener al menos 32 caracteres.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Alternativa para varios usuarios manuales. Si se define, reemplaza los dos campos anteriores.
# DASHBOARD_USERS_JSON={"administrador":"cambia-esta-clave","operador":"otra-clave"}
AUTH_SECRET=
AUTH_COOKIE_SECURE=true
